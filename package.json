{
  "name": "tom-sakura",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Tom Sakura desktop anime library and player",
  "author": "Tom Sakura",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win --x64",
    "pack": "npm run build && electron-builder --dir",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "npm run build && electron tests/desktop-smoke.cjs",
    "test:appearance": "npm run build && electron tests/appearance-smoke.cjs",
    "test:live": "electron tests/live-catalog.cjs",
    "test:media": "npm run build && electron tests/media-live.cjs",
    "test:provider": "npm run build && electron tests/media-live.cjs --provider-live",
    "test:failover": "npm run build && electron tests/media-live.cjs --provider-live --fail-primary",
    "test:app": "npm run build && electron tests/app-live.cjs",
    "test:resilience": "npm run build && electron tests/player-resilience.cjs",
    "test:soak": "npm run build && electron tests/media-live.cjs --provider-live --fail-primary --soak"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "hls.js": "^1.7.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^45.3.3",
    "electron-builder": "^26.0.0",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  },
  "overrides": { "minimatch@>=7 <11.0.1": "^11.0.1" },
  "build": {
    "appId": "com.tomsakura.desktop",
    "productName": "Tom Sakura",
    "directories": {
      "output": "release/1.4.0"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${arch}-Setup.${ext}",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": { "artifactName": "${productName}-${version}-${arch}-Portable.${ext}" }
  }
}
